                    "users"
                ],
                "summary": "[MEM-API-006] ユーザ規約同意状況更新",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Bearer \u003cfirebase_id_token\u003e",
                        "name": "Authorization",
                        "in": "header",
