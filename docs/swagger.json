                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/users/agreements": {
            "get": {
                "description": "指定したユーザの規約同意状況を参照する。ユーザ情報はヘッダから取得する。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "users"
                ],
                "summary": "[MEM-API-005] ユーザ規約同意状況参照",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Bearer \u003cfirebase_id_token\u003e",
                        "name": "Authorization",
                        "in": "header",
