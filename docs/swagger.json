        "/users/login": {
            "put": {
                "description": "ユーザログイン処理を実施する。Ph0では公開用ユーザIDを返却するだけ。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "users"
                ],
                "summary": "[MEM-API-007]ユーザログイン",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Bearer \u003cfirebase_id_token\u003e",
                        "name": "Authorization",
                        "in": "header",
