    },
    "definitions": {
        "dto.AgreementPolicyRequest": {
            "type": "object",
            "required": [
                "policy_type",
                "version"
            ],
            "properties": {
                "policy_type": {
                    "description": "規約タイプ",
                    "type": "string",
                    "example": "privacy_policy"
                },
                "version": {
                    "description": "規約バージョン",
                    "type": "string",
                    "example": "1.4"
                }
            }
        },
        "dto.ContainerDetailItem": {
            "type": "object",
            "properties": {
                "contributers": {
                    "description": "貢献者情報",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.ContributerInfo"
                    }
                },
                "issue": {
                    "description": "号",
                    "type": "string",
                    "example": "第11号"
                },
                "main_title": {
                    "description": "主題",
                    "type": "string",
                    "example": "第1章 「学校」制度の境界線"
                },
                "option_value": {
                    "description": "オプション書誌項目値情報",
                    "allOf": [
                        {
                            "$ref": "#/definitions/dto.OptionValues"
                        }
                    ]
                },
                "read_status": {
                    "description": "既読ステータス",
                    "enum": [
                        "unread",
                        "reading",
                        "partially_read",
                        "read"
                    ],
                    "allOf": [
                        {
                            "$ref": "#/definitions/record.ReadStatus"
                        }
                    ]
                },
                "sub_title": {
                    "description": "副題",
                    "type": "string",
                    "example": "その形成と展開"
                },
                "volume": {
                    "description": "巻",
                    "type": "string",
                    "example": "日本教育史講座第1巻"
                }
            }
        },
        "dto.ContainerListItemResponse": {
            "type": "object",
            "properties": {
                "contributers": {
                    "description": "収録物貢献者情報",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.ContributerInfo"
                    }
                },
                "issue": {
                    "description": "号",
                    "type": "string",
                    "example": "第11号"
                },
                "main_title": {
                    "description": "収録物主題",
                    "type": "string",
                    "example": "境界線の学校史"
                },
                "sub_title": {
                    "description": "収録物副題",
                    "type": "string",
                    "example": "戦後日本の学校か社会の周辺と周縁"
                },
                "volume": {
                    "description": "巻",
                    "type": "string",
                    "example": "日本教育史講座第1巻"
                }
            }
        },
        "dto.ContributerInfo": {
            "type": "object",
            "properties": {
                "name": {
                    "description": "貢献者名（人物名、研究会名など）",
                    "type": "string",
                    "example": "木村元"
                },
                "role": {
                    "description": "役割",
                    "enum": [
                        "author",
                        "interpreter",
                        "compiler",
                        "compiler_author"
                    ],
                    "allOf": [
                        {
                            "$ref": "#/definitions/record.ContributerRole"
                        }
                    ]
                }
            }
        },
        "dto.CreateRecordRequest": {
            "type": "object",
            "required": [
                "main_title",
                "type"
            ],
            "properties": {
                "container": {
                    "description": "収録物詳細情報",
                    "allOf": [
                        {
                            "$ref": "#/definitions/dto.ContainerDetailItem"
                        }
                    ]
                },
                "contributers": {
                    "description": "貢献者情報",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.ContributerInfo"
                    }
                },
                "main_title": {
                    "description": "主題",
                    "type": "string",
                    "example": "第1章 「学校」制度の境界線"
                },
                "memos": {
                    "description": "メモ情報",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.MemoInfo"
                    }
                },
                "option_value": {
                    "description": "オプション書誌項目値情報",
                    "allOf": [
                        {
                            "$ref": "#/definitions/dto.OptionValues"
                        }
                    ]
                },
                "page_range": {
                    "description": "ページ数",
                    "type": "string",
                    "example": "15-46"
                },
                "publication_date": {
                    "description": "出版年（月日）",
                    "type": "string",
                    "example": "2022-11-30"
                },
                "publisher": {
                    "description": "出版社/出版者",
                    "type": "string",
                    "example": "東京大学出版会"
                },
                "read_status": {
                    "description": "既読ステータス",
                    "enum": [
                        "unread",
                        "reading",
                        "partially_read",
                        "read"
                    ],
                    "allOf": [
                        {
                            "$ref": "#/definitions/record.ReadStatus"
                        }
                    ]
                },
                "sub_title": {
                    "description": "副題",
                    "type": "string",
                    "example": "その形成と展開"
                },
                "type": {
                    "description": "書誌タイプ",
                    "type": "string",
                    "enum": [
                        "monograph",
                        "journal_article",
                        "compilation_article"
                    ]
                },
                "urls": {
                    "description": "URL情報",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.UrlInfo"
                    }
                }
            }
        },
        "dto.CreateRecordResponse": {
            "type": "object",
            "required": [
                "record_id",
                "user_id"
            ],
            "properties": {
                "record_id": {
                    "description": "公開用書誌ID",
                    "type": "string"
                },
                "user_id": {
                    "description": "公開用ユーザID（26桁固定ULID）",
                    "type": "string"
                }
            }
        },
        "dto.CreateUserRequest": {
            "type": "object",
            "required": [
                "privacy_policy_agreed_version",
                "terms_agreed_version"
            ],
            "properties": {
                "privacy_policy_agreed_version": {
                    "type": "string",
                    "example": "1.4"
                },
                "terms_agreed_version": {
                    "description": "ユーザ規約同意バージョン",
                    "type": "string",
                    "example": "1.2"
                }
            }
        },
        "dto.CreateUserResponse": {
            "type": "object",
            "required": [
                "user_id"
            ],
            "properties": {
                "user_id": {
                    "description": "公開用ユーザID(26文字固定ULID）",
                    "type": "string",
                    "example": "001JSUFP94SNN~"
                }
            }
        },
